[
  {"note": "#2255: theme tiles offer the built-in themes; choosing one applies it immediately, and Cancel restores the previous theme."},
  {"click": {"handle": "titlebar:preferences"}},
  {"expect": {"prefs": {"dialog": "General", "theme": "nuclear-graphite", "dark": true}}},
  {"widget": "Interface"},
  {"click": {"handle": "prefs:theme:nuclear-light"}},
  {"expect": {"prefs": {"theme": "nuclear-light", "dark": false}, "shown_handles": ["prefs:theme"]}},
  {"click": {"handle": "prefs:theme:nuclear-carbon"}},
  {"expect": {"prefs": {"theme": "nuclear-carbon", "dark": true}}},
  {"click": {"handle": "prefs:theme:nuclear-light"}},
  {"expect": {"prefs": {"theme": "nuclear-light", "dark": false}}},
  {"widget": "Cancel"},
  {"expect": {"prefs": {"dialog": null, "theme": "nuclear-graphite", "dark": true}}},
  {"note": "Okibi (dark) and Akari (light) are built in by id."},
  {"call": "ui.prefs", "params": {"theme": "akari"}},
  {"expect": {"prefs": {"theme": "akari", "dark": false}}},
  {"call": "ui.prefs", "params": {"theme": "okibi"}},
  {"expect": {"prefs": {"theme": "okibi", "dark": true}}}
]
